<send_true_to>Informe válido (log)</send_true_to><send_false_to>Abortar: informe incorrecto o vacío</send_false_to><compare><condition><negated>N</negated><operator>-</operator><conditions><condition><negated>N</negated><leftvalue>n_grupos</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>13</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>suma_reservas</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>15</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition><condition><negated>N</negated><operator>AND</operator><leftvalue>total_centimos</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>396550</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition></conditions></condition></compare>
