<all_rows>N</all_rows><ignore_aggregate>N</ignore_aggregate><field_ignore/><directory>${java.io.tmpdir}</directory><prefix>grp</prefix><add_linenr>N</add_linenr><linenr_fieldname/><give_back_row>Y</give_back_row><group></group><fields><field><aggregate>n_ids</aggregate><subject></subject><type>COUNT_ANY</type><valuefield/></field></fields>
