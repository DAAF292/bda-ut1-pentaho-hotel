<transformation>
<info><name>validar_sin_cobro</name><description>Validación del listado provisional sin cobro</description><extended_description/><trans_version/><trans_type>Normal</trans_type><directory>/</directory><parameters></parameters><size_rowset>10000</size_rowset><sleep_time_empty>50</sleep_time_empty><sleep_time_full>50</sleep_time_full><unique_connections>N</unique_connections><feedback_shown>Y</feedback_shown><feedback_size>50000</feedback_size><using_thread_priorities>Y</using_thread_priorities><shared_objects_file/><capture_step_performance>N</capture_step_performance><step_performance_capturing_delay>1000</step_performance_capturing_delay><step_performance_capturing_size_limit>100</step_performance_capturing_size_limit><dependencies></dependencies><partitionschemas></partitionschemas><slaveservers></slaveservers><clusterschemas></clusterschemas><created_user>-</created_user><created_date>2026/11/25 12:00:00.000</created_date><modified_user>-</modified_user><modified_date>2026/11/25 12:00:00.000</modified_date></info>
<notepads><notepad><note>Diego Andrés Afanador - Pregunta que resuelve: ¿el listado provisional de reservas sin cobro contiene exactamente las 5 reservas esperadas (4, 9, 11, 15, 18), sin duplicados? Un CSV solo con cabecera debe fallar (Always give back a result row + Abort con umbral 0).</note><xloc>20</xloc><yloc>380</yloc><width>800</width><heigth>60</heigth><fontname>Segoe UI</fontname><fontsize>9</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic><fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue><backgroundcolorred>255</backgroundcolorred><backgroundcolorgreen>205</backgroundcolorgreen><backgroundcolorblue>112</backgroundcolorblue><bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue><drawshadow>Y</drawshadow></notepad></notepads>
<order><hop><from>Leer sin cobro provisional</from><to>Identificador esperado</to><enabled>Y</enabled></hop><hop><from>Identificador esperado</from><to>Ordenar por id_reserva</to><enabled>Y</enabled></hop><hop><from>Identificador esperado</from><to>Abortar: identificador inválido</to><enabled>Y</enabled></hop><hop><from>Ordenar por id_reserva</from><to>Contar filas por id_reserva</to><enabled>Y</enabled></hop><hop><from>Contar filas por id_reserva</from><to>Sin duplicados (una fila por id)</to><enabled>Y</enabled></hop><hop><from>Sin duplicados (una fila por id)</from><to>Resumen sin claves (siempre devuelve fila)</to><enabled>Y</enabled></hop><hop><from>Sin duplicados (una fila por id)</from><to>Abortar: identificador duplicado</to><enabled>Y</enabled></hop><hop><from>Resumen sin claves (siempre devuelve fila)</from><to>Comprobar cinco identificadores</to><enabled>Y</enabled></hop><hop><from>Comprobar cinco identificadores</from><to>Sin cobro válido (log)</to><enabled>Y</enabled></hop><hop><from>Comprobar cinco identificadores</from><to>Abortar: no hay cinco identificadores</to><enabled>Y</enabled></hop></order>
<step><name>Leer sin cobro provisional</name><type>CsvInput</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<filename>${Internal.Transformation.Filename.Directory}/../temporal/reservas_sin_cobro.csv</filename><filename_field/><rownum>N</rownum><rownum_field/><include_filename>N</include_filename><separator>;</separator><enclosure>"</enclosure><header>Y</header><buffer_size>50000</buffer_size><schema_definition/><lazy_conversion>N</lazy_conversion><add_filename_result>N</add_filename_result><parallel>N</parallel><newline_possible>N</newline_possible><encoding>UTF-8</encoding><fields><field><name>id_reserva</name><type>Integer</type><format>#</format><currency/><decimal/><group/><length>15</length><precision>0</precision><trim_type>none</trim_type></field><field><name>hotel</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>canal</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>importe</name><type>BigNumber</type><format>#.#</format><currency/><decimal>.</decimal><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field><field><name>motivo</name><type>String</type><format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type></field></fields>
<cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>60</xloc><yloc>100</yloc><draw>Y</draw></GUI></step>
<step><name>Identificador esperado</name><type>FilterRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<send_true_to>Ordenar por id_reserva</send_true_to><send_false_to>Abortar: identificador inválido</send_false_to><compare><condition><negated>N</negated><operator>-</operator><conditions><condition><negated>N</negated><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>4</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>9</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>11</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>15</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition><condition><negated>N</negated><operator>OR</operator><leftvalue>id_reserva</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>18</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition></conditions></condition></compare>
<cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>300</xloc><yloc>100</yloc><draw>Y</draw></GUI></step>
<step><name>Abortar: identificador inválido</name><type>Abort</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<row_threshold>0</row_threshold><message>VALIDACION FALLIDA: reservas_sin_cobro.csv contiene un id_reserva fuera de la lista esperada (4, 9, 11, 15, 18)</message><always_log_rows>Y</always_log_rows><abort_option>ABORT_WITH_ERROR</abort_option>
<cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>300</xloc><yloc>260</yloc><draw>Y</draw></GUI></step>
<step><name>Ordenar por id_reserva</name><type>SortRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<directory>${java.io.tmpdir}</directory><prefix>out</prefix><sort_size>1000000</sort_size><free_memory/><compress>N</compress><compress_variable/><unique_rows>N</unique_rows><fields><field><name>id_reserva</name><ascending>Y</ascending><case_sensitive>Y</case_sensitive><collator_enabled>N</collator_enabled><collator_strength>0</collator_strength><presorted>N</presorted></field></fields>
<cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>540</xloc><yloc>100</yloc><draw>Y</draw></GUI></step>
<step><name>Contar filas por id_reserva</name><type>GroupBy</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<all_rows>N</all_rows><ignore_aggregate>N</ignore_aggregate><field_ignore/><directory>${java.io.tmpdir}</directory><prefix>grp</prefix><add_linenr>N</add_linenr><linenr_fieldname/><give_back_row>N</give_back_row><group><field><name>id_reserva</name></field></group><fields><field><aggregate>n_filas</aggregate><subject></subject><type>COUNT_ANY</type><valuefield/></field></fields>
<cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>740</xloc><yloc>100</yloc><draw>Y</draw></GUI></step>
<step><name>Sin duplicados (una fila por id)</name><type>FilterRows</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<send_true_to>Resumen sin claves (siempre devuelve fila)</send_true_to><send_false_to>Abortar: identificador duplicado</send_false_to><compare><condition><negated>N</negated><leftvalue>n_filas</leftvalue><function>=</function><rightvalue/><value><name>constant</name><type>Integer</type><text>1</text><length>-1</length><precision>-1</precision><isnull>N</isnull></value></condition></compare>
<cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>960</xloc><yloc>100</yloc><draw>Y</draw></GUI></step>
<step><name>Abortar: identificador duplicado</name><type>Abort</type><description/><distribute>Y</distribute><custom_distribution/><copies>1</copies><partitioning><method>none</method><schema_name/></partitioning>
<row_threshold>0</row_threshold><message>VALIDACION FALLIDA: reservas_sin_cobro.csv tiene un id_reserva duplicado</message><always_log_rows>Y</always_log_rows><abort_option>ABORT_WITH_ERROR</abort_option>
<cluster_schema/><remotesteps><input></input><output></output></remotesteps><GUI><xloc>960</xloc><yloc>260</yloc><draw>Y</draw></GUI></step>
